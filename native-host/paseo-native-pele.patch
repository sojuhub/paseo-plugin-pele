+import { describe, expect, it, vi } from "vitest";
+import MarkdownIt from "markdown-it";
+import { MarkdownFenceBlock } from "./index";
+import { PeleFence } from "./pele";
+import { MermaidFence } from "./mermaid";
+import { HighlightedCodeBlock } from "@/components/highlighted-code-block";
+
+vi.mock("@/components/highlighted-code-block", () => ({
+  HighlightedCodeBlock: () => null,
+}));
+vi.mock("./mermaid", () => ({ MermaidFence: () => null }));
+vi.mock("./pele", () => ({ PeleFence: () => null }));
+
+describe("Markdown diagram fence routing", () => {
+  it.each([
+    ["MERMAID title", MermaidFence],
+    ["PELE title", PeleFence],
+  ])("routes a %s fence parsed from Markdown to its renderer", (info, renderer) => {
+    const [fence] = new MarkdownIt()
+      .parse(`\`\`\`${info}\nflowchart LR\nA --> B\n\`\`\``, {})
+      .filter((token) => token.type === "fence");
+    expect(fence).toBeDefined();
+
+    const element = MarkdownFenceBlock({
+      code: fence!.content,
+      info: fence!.info,
+      phase: "complete",
+      inheritedStyles: {},
+      textStyle: {},
+    });
+
+    expect(element).toMatchObject({ type: renderer });
+  });
+
+  it("keeps ordinary fenced code on the highlighted source path", () => {
+    const [fence] = new MarkdownIt()
+      .parse("```ts\nconst answer = 42\n```", {})
+      .filter((token) => token.type === "fence");
+    const element = MarkdownFenceBlock({
+      code: fence!.content,
+      info: fence!.info,
+      phase: "complete",
+      inheritedStyles: {},
+      textStyle: {},
+    });
+
+    expect(element).toMatchObject({ type: HighlightedCodeBlock, props: { language: "ts" } });
+  });
+});
